# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
PhysioPose/[Ll]ibrary/
PhysioPose/[Tt]emp/
PhysioPose/[Oo]bj/
PhysioPose/[Bb]uild/
PhysioPose/[Bb]uilds/
PhysioPose/[Ll]ogs/
PhysioPose/[Uu]ser[Ss]ettings/
PhysioPose/[Mm]emoryCaptures/
PhysioPose/[Pp]erf/
PhysioPose/[Aa]rtifacts/
PhysioPose/[Bb]urstCache/
PhysioPose/[Pp]ackageCache/
PhysioPose/[Aa]rtifactDB

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
PhysioPose/[Mm]emoryCaptures/

# Recordings can get excessive in size
PhysioPose/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# PhysioPose/[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
PhysioPose/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
PhysioPose/.vs/

# Gradle cache directory
PhysioPose/.gradle/

# Autogenerated VS/MD/Consulo solution and project files
PhysioPose/ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.fobj

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
PhysioPose/sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
PhysioPose/crashlytics-build.properties

# Packed Addressables
PhysioPose/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
PhysioPose/[Aa]ssets/[Ss]treamingAssets/aa.meta
PhysioPose/[Aa]ssets/[Ss]treamingAssets/aa/*

*.scenes
*.unity
*.unity.meta

PhysioPose/[Tt]emp/
